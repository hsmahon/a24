{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "playback-token",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "supplemental_video_content_slug": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "supplemental_video_content_slug"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "jwt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "jwt"
      ],
      "additionalProperties": true
    }
  }
}
