{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assets",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "format": "uri"
      },
      "titles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "url",
      "titles"
    ],
    "additionalProperties": false
  }
}
