{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "download-status",
  "type": "object",
  "additionalProperties": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "const": "downloading"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "name"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "const": "complete"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "duration": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "name",
          "path",
          "bytes",
          "duration"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "const": "failed"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "name",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  }
}
