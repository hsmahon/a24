{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brightcove-playback",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "description": "Milliseconds."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string"
          },
          "codecs": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "height": {
            "type": "number"
          },
          "width": {
            "type": "number"
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": true
      }
    },
    "poster": {
      "type": [
        "string",
        "null"
      ]
    },
    "thumbnail": {
      "type": [
        "string",
        "null"
      ]
    },
    "text_tracks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "id",
    "name",
    "duration",
    "sources"
  ],
  "additionalProperties": true
}
