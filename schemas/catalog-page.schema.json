{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catalog-page",
  "type": "object",
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "next": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "previous": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "title.schema.json"
      }
    }
  },
  "required": [
    "count",
    "next",
    "previous",
    "results"
  ],
  "additionalProperties": true
}
